digraph G {
  rankdir=LR; nodesep=0.35; ranksep=0.9; bgcolor="white";
  node [shape=box, style="rounded", fontname="Liberation Serif", fontsize=13, margin="0.12,0.07", color="#222222"];
  edge [fontname="Liberation Serif", fontsize=12, color="#222222"];
  A [label="Caché bajo demanda\n(con / sin)\nIndependiente", color="#2b5db8", fontcolor="#2b5db8"];
  B [label="Mirror sincronizado\n(con / sin)\nIndependiente", color="#2b5db8", fontcolor="#2b5db8"];
  T [label="Tiempo de preparación\np95 (s)\nDependiente"];
  G [label="Tráfico de salida\n(GB por sesión)\nDependiente"];
  M [label="Estaciones concurrentes N\n(1, 10, 30)\nModeradora", shape=box, style="rounded,dashed"];
  X [shape=point, width=0.05, label=""];
  A -> T [label=" −"]; A -> G [label=" −"];
  B -> T [label=" −"]; B -> G [label=" −"];
  A -> B [label=" efecto\n conjunto (?)", style=dashed, constraint=false, dir=both, color="#888888", fontcolor="#555555"];
  M -> X [arrowhead=none, style=dashed]; X -> T [style=dashed, constraint=false];

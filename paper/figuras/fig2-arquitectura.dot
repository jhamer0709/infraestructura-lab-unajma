digraph G {
  rankdir=TB; nodesep=0.25; ranksep=0.5; bgcolor="white"; compound=true;
  node [shape=box, style="rounded", fontname="Liberation Serif", fontsize=12, margin="0.1,0.06", color="#222222"];
  edge [fontname="Liberation Serif", fontsize=11, color="#222222"];
  subgraph cluster_a { label="Actual"; fontname="Liberation Serif"; fontsize=13; style=dashed; color="#888888";
    E1 [label="30 estaciones del laboratorio\nmedida: script en cada estación", color="#c77d00", fontcolor="#7a4b00", style="rounded,filled", fillcolor="#fbf0dc"];
    R1 [label="Router y enlace de salida\nmedida: tráfico de salida", color="#c77d00", fontcolor="#7a4b00", style="rounded,filled", fillcolor="#fbf0dc"];
    I1 [label="Internet\n(apt, PyPI, npm, Docker Hub)\nfuera de la frontera, declarado"];
    E1 -> R1 [label=" N descargas idénticas"]; R1 -> I1; }
  subgraph cluster_p { label="Propuesta: azul = lo que se interviene; ámbar = dónde se mide"; fontname="Liberation Serif"; fontsize=12; style=dashed; color="#888888";
    E2 [label="30 estaciones del laboratorio\nmedida: script en cada estación", color="#c77d00", fontcolor="#7a4b00", style="rounded,filled", fillcolor="#fbf0dc"];
    subgraph cluster_f { label="Frontera del sistema"; fontname="Liberation Serif"; fontsize=11; style=dotted; color="#2b5db8"; fontcolor="#2b5db8";
      N2 [label="Nodo en la LAN\nCaché bajo demanda\n+ mirror sincronizado", color="#2b5db8", fontcolor="#2b5db8", penwidth=2, style="rounded,filled", fillcolor="#e8effa"]; }
    R2 [label="Router y enlace de salida\nmedida: tráfico de salida", color="#c77d00", fontcolor="#7a4b00", style="rounded,filled", fillcolor="#fbf0dc"];
    I2 [label="Internet\n(apt, PyPI, npm, Docker Hub)\nfuera de la frontera, declarado"];
    E2 -> N2 [label=" 1 consulta local"]; N2 -> R2 [label=" solo fallos y\n sincronización", color="#2b5db8", fontcolor="#2b5db8"]; R2 -> I2; }
}

# Referencia de variables. En local se definen en la terminal antes de arrancar;
# en Vercel, en Settings > Environment Variables. Nunca subir valores reales.

# Conexión a PostgreSQL (Supabase: pooler de transacciones, puerto 6543).
# Vacío = SQLite local (demostrador.db).
DATABASE_URL=

# Configuración que se usa cuando el pedido no indica una: base, cache, mirror, ambos.
CONFIGURACION=base

# Tiempo que tarda el origen simulado en entregar un paquete de peso 1, en ms.
ORIGEN_RETARDO_MS=50

# Etiqueta que se guarda con cada sesión: demostrador, ensayo, laboratorio.
ENTORNO=demostrador
